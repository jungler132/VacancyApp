# Optional. Without these keys the app stays guest-only (offline, no sync).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional job-board keys. Empty = those sources stay off or limited.
# EXPO_PUBLIC_ADZUNA_APP_ID=
# EXPO_PUBLIC_ADZUNA_APP_KEY=
# EXPO_PUBLIC_JOOBLE_KEY=
# EXPO_PUBLIC_USAJOBS_KEY=
# EXPO_PUBLIC_USAJOBS_EMAIL=

# AdMob. App ID needs a native rebuild (yarn android).
# EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-xxxxxxxx~xxxxxxxx
# EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=ca-app-pub-xxxxxxxx/yyyyyyyy
# EXPO_PUBLIC_ADMOB_BANNER_ID=ca-app-pub-xxxxxxxx/yyyyyyyy
# Keep 1 while testing on device. Set 0 only for the Play store build.
EXPO_PUBLIC_ADMOB_USE_TEST_ADS=1

# One-time Play product id (Monetize → in-app products).
EXPO_PUBLIC_PLAY_PREMIUM_SKU=vakano_premium
