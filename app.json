{
  "expo": {
    "name": "Workly",
    "slug": "Workly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "workly",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "package": "com.workly.app",
      "versionCode": 1,
      "userInterfaceStyle": "automatic",
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#00236f",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#00236f",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#00236f"
          },
          "android": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#00236f",
            "imageWidth": 200
          }
        }
      ],
      "expo-font",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Workly needs photos for avatars and services / фото для аватара и услуг / avatar və xidmət şəkilləri.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/withAndroidReleaseSigning.js",
      "@react-native-vector-icons/material-design-icons",
      "expo-background-task",
      [
        "expo-notifications",
        {
          "color": "#00236f",
          "defaultChannel": "workly-alerts"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true,
            "useLegacyPackaging": true,
            "networkInspector": false,
            "extraProguardRules": "-keep class com.swmansion.reanimated.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }\n-keep class com.horcrux.svg.** { *; }\n-keep class expo.modules.** { *; }\n-keep class com.google.android.gms.ads.** { *; }\n-keep class com.google.android.gms.internal.ads.** { *; }\n-keep class com.google.android.gms.internal.consent_sdk.** { *; }\n-dontwarn expo.modules.**\n-dontwarn com.horcrux.svg.**\n-dontwarn com.google.android.gms.**"
          }
        }
      ],
      "./plugins/withAndroidApkSize.js",
      "./plugins/withPlayServicesAdsPin.js",
      "expo-localization",
      "expo-iap",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6203993897795010~9453438867",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
